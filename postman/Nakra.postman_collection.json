  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const body = pm.request.body;",
          "if (body && body.mode === 'formdata') {",
          "  const fileField = body.formdata.find(f => f.type === 'file' && !f.disabled);",
          "  const hasFile = fileField && fileField.src && (Array.isArray(fileField.src) ? fileField.src.length : true);",
          "  if (fileField && !hasFile) {",
          "    console.warn(`Skipped \"${pm.info.requestName}\": choose a file in Body > form-data`);",
          "    if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
          "  }",
          "}"
        ]
      }
    }
  ]
