          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/restaurants/{{restaurantId}}",
            "description": "Pick a logo file in Body > form-data. The old logo file is deleted.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "logo",
                  "type": "file",
                  "src": [],
                  "disabled": false,
                  "description": "Choose an image (JPG / PNG / WEBP, max 3 MB)"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success (2xx)', () => pm.response.to.be.success);"
                ]
              }
