              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('success (2xx)', () => pm.response.to.be.success);",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('category2Id', j.category.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename category",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/restaurants/{{restaurantId}}/categories/{{categoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hot Drinks ☕\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
